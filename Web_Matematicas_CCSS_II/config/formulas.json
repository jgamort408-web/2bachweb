{
  "schemaVersion": 1,
  "description": "Formulario por tema (P06). Cada fórmula se copia de la lección indicada en «page»: scripts/build-formulas.mjs comprueba que el TeX («tex», o cada fragmento de «from» cuando la fórmula reúne celdas de una tabla o dos líneas) aparece literalmente en esa lección. «note» es una condición breve tomada del texto de la lección.",
  "formulas": [
    { "name": "Límite y límites laterales", "page": "t01-e02", "tex": "\\lim_{x\\to a}f(x)=L\\quad\\Longleftrightarrow\\quad L_-=L_+=L." },
    { "name": "Continuidad en un punto", "page": "t01-e10", "tex": "\\lim_{x\\to a^-}f(x)=\\lim_{x\\to a^+}f(x)=f(a)." },
    { "name": "Tasa de variación media", "page": "t01-e11", "tex": "\\operatorname{TVM}_{[a,a+h]}=\\frac{f(a+h)-f(a)}{h}." },
    { "name": "Derivada en un punto", "page": "t01-e11", "tex": "f'(a)=\\lim_{h\\to0}\\frac{f(a+h)-f(a)}h." },
    { "name": "Recta tangente", "page": "t01-e13", "tex": "y-f(a)=f'(a)(x-a)." },
    { "name": "Recta normal", "page": "t01-e13", "tex": "y-f(a)=-\\frac1{f'(a)}(x-a).", "note": "Si f'(a) ≠ 0." },
    { "name": "Derivada de una potencia", "page": "t01-e14", "tex": "(x^n)'=nx^{n-1}", "from": ["\\(x^n\\)", "\\(nx^{n-1}\\)"] },
    { "name": "Exponencial y logaritmo", "page": "t01-e14", "tex": "(e^x)'=e^x,\\qquad(A^x)'=A^x\\ln A,\\qquad(\\ln x)'=\\dfrac1x", "from": ["\\(A^x\\ln A\\)", "\\(\\ln x\\)</td><td>\\(\\dfrac1x\\)"] },
    { "name": "Producto", "page": "t01-e15", "tex": "(uv)'=u'v+uv'." },
    { "name": "Cociente", "page": "t01-e15", "tex": "\\left(\\frac uv\\right)'=\\frac{u'v-uv'}{v^2},\\qquad v\\ne0." },
    { "name": "Regla de la cadena", "page": "t01-e16", "tex": "\\big(F(g(x))\\big)'=F'(g(x))\\,g'(x)." },
    { "name": "Regla de L'Hôpital", "page": "t01-e18", "tex": "\\lim\\frac{f(x)}{g(x)}=\\lim\\frac{f'(x)}{g'(x)}.", "note": "Solo ante 0/0 o ∞/∞, comprobando las hipótesis." },

    { "name": "Dominio de una función racional", "page": "t02-e03", "tex": "D=\\{x\\in\\mathbb R:Q(x)\\ne0\\}." },
    { "name": "Crecimiento exponencial", "page": "t02-e04", "tex": "V(t)=V_0(1+r)^t,\\qquad r>-1." },
    { "name": "Definición de logaritmo", "page": "t02-e05", "tex": "\\log_a x=y\\quad\\Longleftrightarrow\\quad a^y=x." },
    { "name": "Propiedades de los logaritmos", "page": "t02-e05", "tex": "\\log_a(uv)=\\log_a u+\\log_a v,\\qquad \\log_a(u/v)=\\log_a u-\\log_a v." },
    { "name": "Potencia y cambio de base", "page": "t02-e05", "tex": "\\log_a(u^r)=r\\log_a u,\\qquad\\log_a x=\\frac{\\ln x}{\\ln a}." },
    { "name": "Valor absoluto", "page": "t02-e06", "tex": "|x|=\\begin{cases}-x,&x<0,\\\\x,&x\\ge0.\\end{cases}" },
    { "name": "Traslación", "page": "t02-e07", "tex": "(u,f(u))\\longmapsto(u+a,f(u)+k)." },
    { "name": "Expansión y contracción", "page": "t02-e08", "tex": "g(u/b)=a f(u)=av,\\qquad (u,v)\\longmapsto(u/b,av)." },

    { "name": "Integral indefinida", "page": "t03-e01", "tex": "\\int f(x)\\,dx=F(x)+C,\\qquad C\\in\\mathbb R.", "note": "F es una primitiva de f: F'(x) = f(x)." },
    { "name": "Potencia", "page": "t03-e02", "tex": "\\int x^n\\,dx=\\dfrac{x^{n+1}}{n+1}+C", "note": "n ≠ −1." },
    { "name": "Inversa de x", "page": "t03-e02", "tex": "\\int\\dfrac1x\\,dx=\\ln|x|+C" },
    { "name": "Exponenciales", "page": "t03-e02", "tex": "\\int e^x\\,dx=e^x+C,\\qquad\\int a^x\\,dx=\\dfrac{a^x}{\\ln a}+C", "from": ["\\int e^x\\,dx=e^x+C", "\\int a^x\\,dx=\\dfrac{a^x}{\\ln a}+C"] },
    { "name": "Casi inmediata: potencia lineal", "page": "t03-e03", "tex": "\\int(ax+b)^n dx=\\frac{(ax+b)^{n+1}}{a(n+1)}+C,\\qquad n\\ne-1." },
    { "name": "Casi inmediata: logaritmo", "page": "t03-e03", "tex": "\\int\\frac{dx}{ax+b}=\\frac1a\\ln|ax+b|+C." },
    { "name": "Cambio de variable", "page": "t03-e04", "tex": "\\int h(g(x))g'(x)dx=\\int h(u)du=H(u)+C=H(g(x))+C." },
    { "name": "Integración por partes", "page": "t03-e04", "tex": "\\int u\\,dv=uv-\\int v\\,du.", "note": "Ampliación." },
    { "name": "Teorema fundamental del cálculo", "page": "t03-e06", "tex": "A(x)=\\int_a^x f(t)\\,dt\\quad\\Longrightarrow\\quad A'(x)=f(x)", "from": ["A(x)=\\int_a^x f(t)\\,dt.", "A'(x)=f(x)."], "note": "Si f es continua." },
    { "name": "Regla de Barrow", "page": "t03-e07", "tex": "\\int_a^b f(x)\\,dx=\\left[F(x)\\right]_a^b=F(b)-F(a)." },
    { "name": "Área bajo una curva", "page": "t03-e08", "tex": "A=\\int_a^b|f(x)|\\,dx." },
    { "name": "Área entre dos curvas", "page": "t03-e08", "tex": "A=\\int_a^b|f(x)-g(x)|\\,dx." },

    { "name": "Producto de matrices", "page": "t04-e03", "tex": "\\underbrace{A}_{m\\times n}\\ \\underbrace{B}_{n\\times p}=\\underbrace{C}_{m\\times p},\\qquad c_{ij}=\\sum_{k=1}^{n}a_{ik}b_{kj}." },
    { "name": "Propiedades de la traspuesta", "page": "t04-e05", "tex": "(A^T)^T=A,\\quad(A+B)^T=A^T+B^T,\\quad(\\alpha A)^T=\\alpha A^T,\\quad(AB)^T=B^TA^T." },
    { "name": "Determinante de orden 2", "page": "t04-e06", "tex": "\\begin{vmatrix}a&b\\\\c&d\\end{vmatrix}=ad-bc." },
    { "name": "Determinante de orden 3 (Sarrus)", "page": "t04-e06", "tex": "\\det(A)=aei+bfg+cdh-(ceg+afh+bdi)." },
    { "name": "Propiedades del determinante", "page": "t04-e07", "tex": "\\det(A^T)=\\det(A),\\qquad\\det(AB)=\\det(A)\\det(B)." },
    { "name": "Producto por un número", "page": "t04-e07", "tex": "\\det(kA)=k^n\\det(A).", "note": "A cuadrada de orden n." },
    { "name": "Adjunto de un elemento", "page": "t04-e08", "tex": "C_{ij}=(-1)^{i+j}M_{ij}." },
    { "name": "Desarrollo por una fila", "page": "t04-e08", "tex": "\\det(A)=\\sum_{j=1}^{n}a_{ij}C_{ij}." },
    { "name": "Matriz inversa", "page": "t04-e09", "tex": "A^{-1}=\\frac1{\\det(A)}\\operatorname{Adj}(A).", "note": "Existe si y solo si det(A) ≠ 0." },
    { "name": "Inversa de orden 2", "page": "t04-e09", "tex": "A=\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix},\\qquad A^{-1}=\\frac1{ad-bc}\\begin{pmatrix}d&-b\\\\-c&a\\end{pmatrix},\\quad ad-bc\\ne0." },
    { "name": "Rango", "page": "t04-e10", "tex": "0\\le\\operatorname{rg}(A)\\le\\min(m,n),\\qquad A\\text{ de tamaño }m\\times n." },
    { "name": "Ecuaciones matriciales", "page": "t04-e11", "tex": "AX=B\\ \\Longrightarrow\\ X=A^{-1}B,\\qquad XA=B\\ \\Longrightarrow\\ X=BA^{-1}", "from": ["X=A^{-1}B.", "X=BA^{-1}."], "note": "A invertible; el orden de los factores importa." },
    { "name": "Potencias de la matriz de adyacencia", "page": "t04-e12", "tex": "(A^k)_{ij}=\\text{número de recorridos de exactamente }k\\text{ pasos del vértice }i\\text{ al }j." },

    { "name": "Ecuación lineal", "page": "t05-e01", "tex": "a_1x_1+a_2x_2+\\cdots+a_nx_n=b." },
    { "name": "Teorema de Rouché-Frobenius", "page": "t05-e06", "tex": "\\operatorname{rg}(A)=\\operatorname{rg}(A|B)", "note": "Compatible si y solo si se cumple; determinado cuando ese rango común es n (número de incógnitas) e indeterminado cuando es menor." },
    { "name": "Resolución con la matriz inversa", "page": "t05-e07", "tex": "X=A^{-1}B.", "note": "Sistema AX = B con A invertible." },
    { "name": "Regla de Cramer", "page": "t05-e09", "tex": "x_i=\\frac{\\Delta_i}{\\Delta},\\qquad \\Delta_i=\\det(A_i)." },
    { "name": "Sistemas homogéneos", "page": "t05-e10", "tex": "\\det(A)\\ne0\\ \\Longleftrightarrow\\ \\text{solo solución trivial},\\qquad \\det(A)=0\\ \\Longleftrightarrow\\ \\text{existen soluciones no triviales}." },

    { "name": "Inecuación lineal", "page": "t06-e01", "tex": "ax+by\\le c,\\qquad (a,b)\\ne(0,0)." },
    { "name": "Función objetivo", "page": "t06-e03", "tex": "Z=ax+by.", "note": "Si la región factible es un polígono cerrado, acotado y no vacío, alcanza su máximo y su mínimo en al menos un vértice." },
    { "name": "No negatividad", "page": "t06-e03", "tex": "x\\ge0,\\qquad y\\ge0." },

    { "name": "Regla de Laplace", "page": "t07-e01", "tex": "P(A)=\\frac{|A|}{|\\Omega|}=\\frac{\\text{casos favorables}}{\\text{casos posibles}}.", "note": "Resultados equiprobables." },
    { "name": "Leyes de De Morgan", "page": "t07-e02", "tex": "(A\\cup B)^c=A^c\\cap B^c,\\qquad(A\\cap B)^c=A^c\\cup B^c." },
    { "name": "Probabilidad de la unión", "page": "t07-e02", "tex": "P(A\\cup B)=P(A)+P(B)-P(A\\cap B)." },
    { "name": "Frecuencia relativa", "page": "t07-e04", "tex": "f_n(A)=\\frac{n_A}{n},\\qquad 0\\leq f_n(A)\\leq 1." },
    { "name": "Suceso contrario", "page": "t07-e06", "tex": "P(A^c)=1-P(A)" },
    { "name": "Probabilidad condicionada", "page": "t07-e08", "tex": "P(A\\mid B)=\\frac{P(A\\cap B)}{P(B)}.", "note": "P(B) > 0." },
    { "name": "Regla del producto", "page": "t07-e08", "tex": "P(A\\cap B)=P(B)\\,P(A\\mid B)." },
    { "name": "Probabilidad total", "page": "t07-e09", "tex": "P(B)=\\sum_{i=1}^{n}P(A_i)\\,P(B\\mid A_i).", "note": "A₁, …, Aₙ forman una partición." },
    { "name": "Teorema de Bayes", "page": "t07-e10", "tex": "P(A_i\\mid B)=\\frac{P(A_i)\\,P(B\\mid A_i)}{\\sum_{j=1}^{n}P(A_j)\\,P(B\\mid A_j)}." },

    { "name": "Media de una variable discreta", "page": "t08-e01", "tex": "\\mu=\\sum_{i=1}^{n}x_i p_i." },
    { "name": "Varianza y desviación típica", "page": "t08-e01", "tex": "\\sigma^2=\\sum_{i=1}^{n}x_i^2p_i-\\mu^2,\\qquad\\sigma=\\sqrt{\\sigma^2}", "from": ["\\sigma^2=\\sum_{i=1}^{n}x_i^2p_i-\\mu^2.", "\\sigma=\\sqrt{\\sigma^2}."] },
    { "name": "Distribución binomial", "page": "t08-e02", "tex": "P(X=k)=\\binom{n}{k}p^kq^{n-k}.", "note": "X ∼ B(n, p), q = 1 − p." },
    { "name": "Parámetros de la binomial", "page": "t08-e02", "tex": "\\mu=np,\\qquad\\sigma=\\sqrt{npq}", "from": ["\\mu=np.", "\\sigma=\\sqrt{npq}."] },
    { "name": "Tipificación", "page": "t08-e03", "tex": "Z=\\frac{X-\\mu}{\\sigma}\\sim N(0,1)." },
    { "name": "Probabilidad en un intervalo", "page": "t08-e03", "tex": "P(a\\le X\\le b)=\\Phi\\left(\\frac{b-\\mu}{\\sigma}\\right)-\\Phi\\left(\\frac{a-\\mu}{\\sigma}\\right)." },
    { "name": "Aproximación de la binomial por la normal", "page": "t08-e04", "tex": "X\\sim\\operatorname{Bin}(n,p),\\qquad Y\\sim N\\left(np,\\sqrt{np(1-p)}\\right).", "from": ["X\\sim\\operatorname{Bin}(n,p),\\qquad Y\\sim N\\left(np,\\sqrt{np(1-p)}\\right).", "np\\ge5\\) y \\(n(1-p)\\ge5"], "note": "Si np ≥ 5 y n(1 − p) ≥ 5." },
    { "name": "Corrección por continuidad", "page": "t08-e04", "tex": "P(X=k)\\approx P(k-0{,}5\\le Y\\le k+0{,}5)." },

    { "name": "Media muestral", "page": "t09-e04", "tex": "E(\\bar X)=\\mu,\\qquad \\operatorname{DE}(\\bar X)=\\frac{\\sigma}{\\sqrt n}", "from": ["E(\\bar X)=\\mu,", "\\operatorname{DE}(\\bar X)=\\frac{\\sigma}{\\sqrt n}."] },
    { "name": "Teorema central del límite", "page": "t09-e04", "tex": "\\frac{\\bar X-\\mu}{\\sigma/\\sqrt n}\\;\\xrightarrow[n\\to\\infty]{\\mathrm{distribución}}\\;N(0,1)." },
    { "name": "Proporción muestral", "page": "t09-e04", "tex": "E(\\hat P)=p,\\qquad \\operatorname{Var}(\\hat P)=\\frac{pq}{n},\\qquad \\operatorname{DE}(\\hat P)=\\sqrt{\\frac{pq}{n}}." },
    { "name": "Valor crítico", "page": "t09-e05", "tex": "P(-z_{\\alpha/2}\\le Z\\le z_{\\alpha/2})=1-\\alpha." },
    { "name": "Intervalo característico de la media muestral", "page": "t09-e06", "tex": "\\left[\\mu-z_{\\alpha/2}\\frac{\\sigma}{\\sqrt n},\\;\\mu+z_{\\alpha/2}\\frac{\\sigma}{\\sqrt n}\\right]." },
    { "name": "Intervalo de confianza para la media", "page": "t09-e07", "tex": "IC_{1-\\alpha}(\\mu)=\\left[\\bar x-z_{\\alpha/2}\\frac{\\sigma}{\\sqrt n},\\;\\bar x+z_{\\alpha/2}\\frac{\\sigma}{\\sqrt n}\\right]." },
    { "name": "Error máximo", "page": "t09-e08", "tex": "IC_{1-\\alpha}(\\mu)=\\left[\\bar x-E,\\;\\bar x+E\\right],\\qquad E=z_{\\alpha/2}\\frac{\\sigma}{\\sqrt n}." },
    { "name": "Tamaño mínimo de la muestra", "page": "t09-e08", "tex": "E\\le E_0\\quad\\Longleftrightarrow\\quad n\\ge\\left(\\frac{z_{\\alpha/2}\\sigma}{E_0}\\right)^2,\\qquad n_{\\min}=\\left\\lceil\\left(\\frac{z_{\\alpha/2}\\sigma}{E_0}\\right)^2\\right\\rceil." },

    { "name": "Covarianza", "page": "bivariate", "tex": "S_{xy}=\\frac{\\sum_{i=1}^{N}x_i y_i}{N}-\\bar{x}\\,\\bar{y}." },
    { "name": "Coeficiente de correlación de Pearson", "page": "bivariate", "tex": "r=\\frac{S_{xy}}{S_x\\cdot S_y}.", "note": "−1 ≤ r ≤ 1." },
    { "name": "Recta de regresión de y sobre x", "page": "bivariate", "tex": "\\widehat{y}-\\bar{y}=\\frac{S_{xy}}{S_x^2}(x-\\bar{x})." },
    { "name": "Coeficiente de determinación", "page": "bivariate", "tex": "R^2=r^2." },

    { "name": "Variaciones sin repetición", "page": "combinatorics", "tex": "V(n,r)=\\frac{n!}{(n-r)!}", "note": "El orden importa y no se repite; r ≤ n." },
    { "name": "Variaciones con repetición", "page": "combinatorics", "tex": "VR(n,r)=n^r.", "note": "El orden importa y se puede repetir." },
    { "name": "Permutaciones", "page": "combinatorics", "tex": "P_n=n!", "note": "Se ordenan todos los elementos." },
    { "name": "Permutaciones con elementos repetidos", "page": "combinatorics", "tex": "P_n^{(a,\\,b,\\,\\ldots)}=\\frac{n!}{a!\\cdot b!\\cdots}.", "note": "a, b, … son las veces que se repite cada elemento." },
    { "name": "Combinaciones", "page": "combinatorics", "tex": "C(n,r)=\\binom{n}{r}=\\frac{n!}{r!\\,(n-r)!}.", "note": "El orden no importa y no se repite." }
  ]
